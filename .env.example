# Anthropic API key. Optional: only used by the LLM advisory pass
# (pass 3 of capability derivation). Leave empty to run fully offline.
ANTHROPIC_API_KEY=

# Enable the LLM advisory pass. Off by default. Results are cached by content
# hash and stored in latch.lock so re-runs never produce phantom drift.
LATCH_LLM_ENABLED=false

# Port for the local review UI (`latch review`), served by hono.
LATCH_UI_PORT=7777

# Path to the committed lockfile holding approved tool state.
LATCH_LOCKFILE_PATH=./latch.lock

# Directory for local, uncommitted state: pending review queue and event log.
LATCH_STATE_DIR=./.latch

# Log verbosity: debug | info | warn | error.
LATCH_LOG_LEVEL=info
