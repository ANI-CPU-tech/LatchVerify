# Enable the LLM advisory pass (pass 3 of capability derivation). Off by
# default. Results are cached by content hash and stored in latch.lock so
# re-runs never produce phantom drift. Advisory only: it never blocks a call.
LATCH_LLM_ENABLED=false

# API key for the advisory pass. Any OpenAI-compatible chat-completions API
# works, including the free tiers of Groq and OpenRouter. Leave empty to run
# fully offline.
LATCH_LLM_API_KEY=

# API root and model. Empty means Groq (https://api.groq.com/openai/v1) with
# llama-3.3-70b-versatile. OpenRouter: https://openrouter.ai/api/v1.
LATCH_LLM_BASE_URL=
LATCH_LLM_MODEL=

# Who approvals are recorded as. Empty means git user.email, then the OS user.
LATCH_REVIEWER=

# Port for the local review UI (`latch review`), served by hono.
LATCH_UI_PORT=7777

# Path to the committed lockfile holding approved tool state.
LATCH_LOCKFILE_PATH=./latch.lock

# Directory for local, uncommitted state: pending review queue and event log.
# Empty means .latch next to the lockfile.
LATCH_STATE_DIR=

# Proxy log verbosity on stderr: debug | info | warn | error. debug also names every frame the
# proxy holds, rewrites or answers itself (method and id only, never contents). Set it in a wrapped
# entry's env to debug one server.
LATCH_LOG_LEVEL=info
