# pacman runs these as root; link-user links or unlinks the MCP clients as the user behind sudo.
# LATCH_SKIP_SETUP=1 leaves the clients alone.

post_install() {
  /usr/lib/latchverify/link-user setup || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  /usr/lib/latchverify/link-user remove || true
}
