; LatchVerify installer (Inno Setup 6). Rendered and compiled by scripts/package (target
; windows-installer) on Windows; it packages the staged app in .\LatchVerify. Per-user
; install: no administrator rights, nothing written outside the user's profile.

#define AppName "LatchVerify"
#define AppVersion "@VERSION@"

[Setup]
AppId={{6B1E8E57-3C55-4D8B-9A7F-1D2C5E0B9F31}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=LatchVerify contributors
AppPublisherURL=@HOMEPAGE@
AppSupportURL=@HOMEPAGE@/issues
VersionInfoVersion=@VERSION_NUMERIC@
VersionInfoProductVersion=@VERSION_NUMERIC@
VersionInfoDescription={#AppName} installer
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ChangesEnvironment=yes
LicenseFile=LatchVerify\app\LICENSE
SetupIconFile=LatchVerify\latchverify.ico
UninstallDisplayIcon={app}\latchverify.ico
OutputDir=out
OutputBaseFilename=latchverify-{#AppVersion}-windows-setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
#ifdef Sign
; scripts/package passes /DSign and /Slatchsign=<signtool command> when a certificate is
; configured. Smart App Control requires both executables to be signed.
SignTool=latchsign
SignedUninstaller=yes
#endif

[Tasks]
Name: addtopath; Description: "Add latch to PATH (needed by MCP client configs that ""latch init"" writes)"

[Files]
Source: "LatchVerify\*"; DestDir: "{app}"; Flags: recursesubdirs ignoreversion

[Icons]
Name: "{group}\LatchVerify Review"; Filename: "{app}\LatchVerify Review.cmd"; WorkingDir: "{userdocs}"; IconFilename: "{app}\latchverify.ico"
Name: "{group}\Uninstall LatchVerify"; Filename: "{uninstallexe}"

[Registry]
Root: HKCU; Subkey: "Environment"; ValueType: expandsz; ValueName: "Path"; ValueData: "{olddata};{app}"; Tasks: addtopath; Check: NeedsAddPath(ExpandConstant('{app}'))

[Code]
const
  EnvKey = 'Environment';

{ True when Dir is not already one of the entries in the user's Path. }
function NeedsAddPath(Dir: string): Boolean;
var
  Paths: string;
begin
  if not RegQueryStringValue(HKCU, EnvKey, 'Path', Paths) then
  begin
    Result := True;
    exit;
  end;
  Result := Pos(';' + Uppercase(Dir) + ';', ';' + Uppercase(Paths) + ';') = 0;
end;

{ Removes Dir from the user's Path, leaving every other entry as it was. }
procedure RemoveFromPath(Dir: string);
var
  Paths: string;
  P: Integer;
begin
  if not RegQueryStringValue(HKCU, EnvKey, 'Path', Paths) then
    exit;
  P := Pos(';' + Uppercase(Dir) + ';', ';' + Uppercase(Paths) + ';');
  if P = 0 then
    exit;
  { P is where Dir starts in Paths. Drop it with the separator before it, or after it when first. }
  if P > 1 then
    Delete(Paths, P - 1, Length(Dir) + 1)
  else
    Delete(Paths, 1, Length(Dir) + 1);
  RegWriteExpandStringValue(HKCU, EnvKey, 'Path', Paths);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
    RemoveFromPath(ExpandConstant('{app}'));
end;
