{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode reads JSONC: comments and trailing commas.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "everything": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything"],
    },
  },
}
