// Zed settings
//
// For information on how to configure Zed, see the Zed documentation.
{
  "theme": "One Dark",
  "context_servers": {
    "local-mcp-server": {
      "command": "some-command",
      "args": ["arg-1", "arg-2"],
      "env": {}
    },
    // Remote servers have a url instead of a command.
    "remote-mcp-server": {
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer <token>" },
    },
  },
}
